{
  "name": "POST /v1/charges - declined, insufficient funds (paymentToken tok_declined*)",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/charges",
    "headers": {
      "Idempotency-Key": { "matches": "^[A-Za-z0-9_-]{8,128}$" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.paymentToken", "matches": "^tok_declined.*$" } }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json",
      "Idempotency-Key": "{{request.headers.Idempotency-Key}}",
      "X-Order-Id": "{{jsonPath request.body '$.orderId'}}"
    },
    "bodyFileName": "charge-declined.json",
    "transformers": ["response-template"],
    "transformerParameters": {
      "declineReason": "INSUFFICIENT_FUNDS"
    }
  }
}

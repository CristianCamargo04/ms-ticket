{
  "name": "POST /v1/charges - gateway failure 500 (paymentToken tok_error*), exercises retry and circuit breaker",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/charges",
    "headers": {
      "Idempotency-Key": { "matches": "^[A-Za-z0-9_-]{8,128}$" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.paymentToken", "matches": "^tok_error.*$" } }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json",
      "Idempotency-Key": "{{request.headers.Idempotency-Key}}"
    },
    "bodyFileName": "gateway-error.json",
    "transformers": ["response-template"],
    "transformerParameters": {
      "error": "GATEWAY_ERROR",
      "message": "Simulated payment gateway failure"
    }
  }
}

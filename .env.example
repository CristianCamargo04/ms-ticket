# -----------------------------------------------------------------------------
# Local Docker Compose settings for ms-ticket.
#
#   cp .env.example .env        # .env is git-ignored
#
# Only DUMMY values for the local emulators live here: DynamoDB Local and
# LocalStack accept any credentials. Never put real AWS credentials in this file;
# in AWS the application uses the ECS task role (DefaultCredentialsProvider).
#
# The credentials use a LOCAL_ prefix on purpose: Compose gives shell variables
# precedence over .env, so plain AWS_ACCESS_KEY_ID would silently forward a
# developer's real exported credentials into the containers.
# -----------------------------------------------------------------------------

# Emulator credentials and region (injected as AWS_* inside the containers)
LOCAL_AWS_REGION=us-east-1
LOCAL_AWS_ACCESS_KEY_ID=test
LOCAL_AWS_SECRET_ACCESS_KEY=test

# SQS queue names (must match the application's aws.sqs.order-reservation-queue /
# aws.sqs.order-payment-queue defaults). Each one gets a "<queue>-dlq" dead-letter queue.
SQS_ORDER_RESERVATION_QUEUE=ticketing-order-reservation
SQS_ORDER_PAYMENT_QUEUE=ticketing-order-payment

# Host ports - every published port is bound to 127.0.0.1 only.
# Host port of the containerised API (stop ticketing-api before running the app from the IDE on 8080).
API_HOST_PORT=8080
AUTH_MOCK_HOST_PORT=8090
PAYMENT_MOCK_HOST_PORT=8089
DYNAMODB_HOST_PORT=8000
LOCALSTACK_HOST_PORT=4566
DYNAMODB_ADMIN_HOST_PORT=8001

# Image metadata (optional): stamped into the OCI labels of ms-ticket:local
GIT_COMMIT=local
